{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Aspire (Backend + Frontend + DB)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-apphost",
      "program": "${workspaceFolder}/AppHost/bin/Debug/net10.0/AppHost.dll",
      "args": [],
      "cwd": "${workspaceFolder}/AppHost",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_ENVIRONMENT": "Development",
        "DOTNET_LAUNCH_PROFILE": "https",
        "ASPNETCORE_URLS": "https://localhost:17169;http://localhost:15146",
        "ASPIRE_DASHBOARD_OTLP_ENDPOINT_URL": "https://localhost:21196",
        "ASPIRE_RESOURCE_SERVICE_ENDPOINT_URL": "https://localhost:22294"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Login to the dashboard at (https?://\\S+)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "Aspire: an Backend anhängen",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    },
    {
      "name": "Nur Backend, ohne Aspire (http://localhost:5284)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-backend",
      "program": "${workspaceFolder}/Backend/bin/Debug/net10.0/Backend.dll",
      "args": [],
      "cwd": "${workspaceFolder}/Backend",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5284"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\bNow listening on:\s+(https?://\S+)",
        "uriFormat": "%s/api/events"
      }
    }
  ]
}
